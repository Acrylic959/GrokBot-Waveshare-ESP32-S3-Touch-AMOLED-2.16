+#define AUDIO_CODEC_DMA_DESC_NUM 8
+#define AUDIO_CODEC_DMA_FRAME_NUM 360   // 8*360 frames @24kHz = 120ms
+#define AUDIO_CODEC_I2S_INTR_PRIO 3     // preempt display/LVGL traffic
+#else
 #define AUDIO_CODEC_DMA_DESC_NUM 6
 #define AUDIO_CODEC_DMA_FRAME_NUM 240
+#define AUDIO_CODEC_I2S_INTR_PRIO 0
+#endif
 
